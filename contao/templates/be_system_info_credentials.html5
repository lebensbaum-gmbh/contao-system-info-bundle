<?php
$lang = $GLOBALS['TL_LANG']['system_info_credentials'] ?? [];
$escape = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
?>

<div class="tl_listing_container">
    <div class="tl_box">
        <h2><?= $escape($this->headline) ?></h2>
        <?php if ('' !== (string) $this->intro): ?>
            <p><?= $escape($this->intro) ?></p>
        <?php endif; ?>
    </div>

    <?php if (null !== $this->error): ?>
        <div class="tl_error"><?= $escape($lang['error'] ?? 'Error') ?> <?= $escape($this->error) ?></div>
    <?php else: ?>
        <div class="tl_formbody_edit">
            <fieldset class="tl_tbox block">
                <legend><?= $escape($lang['installationId'] ?? 'Installation ID') ?></legend>
                <div class="widget clr">
                    <div style="display:flex;gap:8px;align-items:center;max-width:760px">
                        <input type="text" id="system_info_id" class="tl_text" readonly value="<?= $escape($this->systemId) ?>" style="flex:1;font-family:monospace">
                        <button type="button" class="tl_submit" data-copy-target="system_info_id"><?= $escape($lang['copy'] ?? 'Copy') ?></button>
                    </div>
                </div>
            </fieldset>

            <fieldset class="tl_box block">
                <legend><?= $escape($lang['secret'] ?? 'Secret') ?></legend>
                <div class="widget clr">
                    <?php if (null !== $this->plainSecret): ?>
                        <div style="display:flex;gap:8px;align-items:center;max-width:760px">
                            <input type="text" id="system_info_secret" class="tl_text" readonly autocomplete="off" value="<?= $escape($this->plainSecret) ?>" style="flex:1;font-family:monospace">
                            <button type="button" class="tl_submit" data-copy-target="system_info_secret"><?= $escape($lang['copy'] ?? 'Copy') ?></button>
                        </div>
                        <p class="tl_help" style="margin-top:8px"><strong><?= $escape($lang['secretVisibleHelp'] ?? '') ?></strong></p>
                        <form method="post" style="margin-top:12px">
                            <input type="hidden" name="FORM_SUBMIT" value="system_info_credentials">
                            <input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken) ?>">
                            <input type="hidden" name="action" value="hide_secret">
                            <button type="submit" class="tl_submit"><?= $escape($lang['hide'] ?? 'Hide secret') ?></button>
                        </form>
                    <?php else: ?>
                        <input type="text" class="tl_text" readonly value="••••••••••••••••••••••••••••••••" style="max-width:760px;font-family:monospace">
                        <p class="tl_help" style="margin-top:8px"><?= $escape($lang['secretHiddenHelp'] ?? '') ?></p>
                        <form method="post" style="margin-top:12px">
                            <input type="hidden" name="FORM_SUBMIT" value="system_info_credentials">
                            <input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken) ?>">
                            <input type="hidden" name="action" value="show_secret">
                            <button type="submit" class="tl_submit"><?= $escape($lang['show'] ?? 'Show secret') ?></button>
                        </form>
                    <?php endif; ?>
                </div>

                <div class="widget clr" style="margin-top:20px">
                    <strong><?= $escape($lang['secretChanged'] ?? 'Secret changed') ?>:</strong>
                    <?= $this->secretChangedAt > 0 ? $escape(date('d.m.Y H:i', (int) $this->secretChangedAt)) : '–' ?>
                </div>

                <form method="post" style="margin-top:20px" onsubmit="return confirm(<?= json_encode((string) ($lang['rotateConfirm'] ?? ''), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>);">
                    <input type="hidden" name="FORM_SUBMIT" value="system_info_credentials">
                    <input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken) ?>">
                    <input type="hidden" name="action" value="rotate_secret">
                    <button type="submit" class="tl_submit"><?= $escape($lang['rotate'] ?? 'Generate new secret') ?></button>
                    <p class="tl_help" style="margin-top:6px"><?= $escape($lang['rotateHelp'] ?? '') ?></p>
                </form>
            </fieldset>

            <fieldset class="tl_box block">
                <legend><?= $escape($lang['endpoint'] ?? 'Endpoint') ?></legend>
                <div class="widget clr">
                    <input type="text" class="tl_text" readonly value="<?= $escape($this->endpointUrl) ?>" style="max-width:760px;font-family:monospace">
                </div>
            </fieldset>
        </div>
    <?php endif; ?>
</div>

<script>
document.querySelectorAll('[data-copy-target]').forEach(function (button) {
    button.addEventListener('click', function () {
        var input = document.getElementById(button.getAttribute('data-copy-target'));
        if (!input) return;
        var text = input.value;
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text);
        } else {
            input.focus();
            input.select();
            document.execCommand('copy');
        }
        var original = button.textContent;
        button.textContent = <?= json_encode((string) ($lang['copied'] ?? 'Copied'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>;
        window.setTimeout(function () { button.textContent = original; }, 1200);
    });
});
</script>
